(dirs :standard \ tmp)

(executable
 (name runner)
 (libraries
  unix
  szaniec_model
  szaniec_program_access
  szaniec_inspection_manager
  szaniec_interpretation_engine
  szaniec_architecture_access))

(executable
 (name complexity_runner)
 (libraries unix yojson))

(rule
 (alias runtest)
 (package szaniec)
 (deps
  (file %{workspace_root}/test/acceptance/run.sh)
  (glob_files expected/*.txt)
  %{bin:szaniec}
  runner.exe
  complexity_runner.exe)
 (action
  (run sh "%{workspace_root}/test/acceptance/run.sh")))

(rule
 (alias runtest)
 (package szaniec)
 (deps
  (file %{workspace_root}/test/acceptance/suggestions.sh)
  %{workspace_root}/bin/szaniec.exe
  (source_tree %{workspace_root}/test/fixtures/suggestions-corpus)
  (glob_files expected/suggestions-corpus*.json))
 (action
  (run sh "%{workspace_root}/test/acceptance/suggestions.sh")))
