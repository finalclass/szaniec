(executable
 (name szaniec)
 (public_name szaniec)
 (libraries
  szaniec_model
  szaniec_inspection_manager
  yojson
  unix))

; Well's production packager expects this path. Keep the existing executable
; name for Dune users and test scripts.
(rule
 (target main.exe)
 (deps szaniec.exe)
 (action (copy %{deps} %{target})))
